rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 두 사람의 구글 이메일만 읽고 쓸 수 있습니다. 실제 이메일은 Firebase 콘솔에만 넣습니다.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['EMAIL_1', 'EMAIL_2'];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
    // 외부 공유 링크: 주소(토큰)를 아는 사람은 그 문서 하나만 읽을 수 있습니다. 목록 조회·쓰기는 두 사람만.
    match /shares/{token} {
      allow get: if true;
    }
  }
}
