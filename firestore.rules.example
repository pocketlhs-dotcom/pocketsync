rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 보드: A = 이현성·권중선, B = 이현성·정규진, C = 이현성·디자인팀(강승연·안은지). 문서마다 board 필드('A' | 'B' | 'C' | 'all').
    // 디자이너는 C만: 'all'(이현성 개인 업무 등)은 보지 못합니다.
    // 실제 이메일은 Firebase 콘솔에만 넣습니다.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function boards() {
      return me() == 'EMAIL_LHS' ? ['A', 'B', 'C', 'all']
        : me() == 'EMAIL_KJS' ? ['A', 'all']
        : me() == 'EMAIL_JGJ' ? ['B', 'all']
        : me() == 'EMAIL_KSY' ? ['C']
        : me() == 'EMAIL_AEJ' ? ['C'] : [];
    }
    function member() { return signedIn() && boards().size() > 0; }
    // 디자인팀(C) 보기 전용: A·B 보드 사람(권중선 · 정규진)은 C의 업무 · 댓글 · 사진을 읽고, C 댓글(확인 · 좋아요 포함)만 쓸 수 있습니다.
    function cReader() { return !('C' in boards()); }
    function cView(col) { return cReader() && col in ['items', 'comments', 'avatars']; }
    // 외부 공유 링크: 주소(토큰)를 아는 사람은 그 문서 하나만 읽을 수 있습니다.
    match /shares/{token} {
      allow get: if true;
    }
    match /{col}/{id} {
      allow read: if member() && (resource == null || resource.data.board in boards() || (resource.data.board == 'C' && cView(col)));
      allow create: if member() && (request.resource.data.board in boards() || (col == 'comments' && request.resource.data.board == 'C' && cReader()));
      allow update: if member() && ((resource.data.board in boards() && request.resource.data.board in boards()) || (col == 'comments' && resource.data.board == 'C' && request.resource.data.board == 'C' && cReader()));
      allow delete: if member() && (resource.data.board in boards() || (col == 'comments' && resource.data.board == 'C' && cReader()));
    }
  }
}
